@model CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0 text-dark">Customer Directory</h4>
        <small class="text-muted">Master customer records and business accounts</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Add Customer
    </a>
</div>

<!-- Search & Filters Card -->
<div class="card p-3 mb-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, email, phone, company..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(Model.Status == CustomerStatus.Active)">Active</option>
                <option value="Inactive" selected="@(Model.Status == CustomerStatus.Inactive)">Inactive</option>
            </select>
        </div>
        @if (Model.SalesUsersList != null && Model.SalesUsersList.Any())
        {
            <div class="col-md-3">
                <select name="assignedToId" asp-items="Model.SalesUsersList" class="form-select">
                    <option value="">All Sales Executives</option>
                </select>
            </div>
        }
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Customers Data Table -->
<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Contact</th>
                    <th>Company</th>
                    <th>Location</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers.Any())
                {
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@c.CustomerCode</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="fw-semibold text-decoration-none text-dark">
                                    @c.CustomerName
                                </a>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-envelope me-1 text-muted"></i>@c.Email</div>
                                <div class="small"><i class="bi bi-telephone me-1 text-muted"></i>@c.Phone</div>
                            </td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.City) || !string.IsNullOrEmpty(c.State))
                                {
                                    <small class="text-muted">@(c.City), @(c.State)</small>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@(c.AssignedTo?.FullName ?? "Unassigned")</small>
                            </td>
                            <td>
                                @if (c.Status == CustomerStatus.Active)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (c.Status == CustomerStatus.Active)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate customer @c.CustomerName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Deactivate">
                                            <i class="bi bi-slash-circle"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2 text-secondary"></i>
                            No customers found matching the search criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
            <small class="text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (Total: @Model.TotalCount customers)</small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.Status" asp-route-assignedToId="@Model.AssignedToId">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.Status" asp-route-assignedToId="@Model.AssignedToId">@p</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.Status" asp-route-assignedToId="@Model.AssignedToId">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
