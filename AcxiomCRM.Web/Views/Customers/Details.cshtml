@model CustomerDetailsViewModel
@{
    ViewData["Title"] = Model.Customer.CustomerName;
    var c = Model.Customer;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0 text-dark">@c.CustomerName</h4>
            <span class="badge bg-light text-dark border font-monospace">@c.CustomerCode</span>
            @if (c.Status == CustomerStatus.Active)
            {
                <span class="badge bg-success-subtle text-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
            }
        </div>
        <small class="text-muted">Created on @c.CreatedDate.ToString("MMMM dd, yyyy") by @(c.CreatedBy?.FullName ?? "System")</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Directory
        </a>
    </div>
</div>

<!-- Customer Profile Summary Card -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Contact Information</h6>
            <div class="mb-2"><span class="text-muted small d-block">Email Address</span><a href="mailto:@c.Email" class="text-dark fw-semibold text-decoration-none">@c.Email</a></div>
            <div class="mb-2"><span class="text-muted small d-block">Phone Number</span><a href="tel:@c.Phone" class="text-dark fw-semibold text-decoration-none">@c.Phone</a></div>
            <div class="mb-2"><span class="text-muted small d-block">Company</span><span class="fw-semibold">@(c.CompanyName ?? "N/A")</span></div>
            <div><span class="text-muted small d-block">Location</span><span>@(c.Address ?? ""), @(c.City ?? ""), @(c.State ?? "")</span></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 h-100">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-person-badge me-2 text-info"></i>Account Ownership</h6>
            <div class="mb-2"><span class="text-muted small d-block">Assigned Sales Executive</span><span class="fw-semibold">@(c.AssignedTo?.FullName ?? "Unassigned")</span></div>
            <div class="mb-2"><span class="text-muted small d-block">Created By</span><span>@(c.CreatedBy?.FullName ?? "System")</span></div>
            <div><span class="text-muted small d-block">Notes</span><p class="small text-muted mb-0">@(c.Notes ?? "No notes added.")</p></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 h-100 bg-light border">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Quick Actions</h6>
            <div class="d-flex flex-column gap-2">
                <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-sm btn-primary text-start">
                    <i class="bi bi-briefcase-fill me-1"></i> Create Opportunity
                </a>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-sm btn-outline-primary text-start">
                    <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
                </a>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-sm btn-outline-secondary text-start">
                    <i class="bi bi-chat-left-text me-1"></i> Log Activity / Call
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Related Opportunities -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-briefcase me-2 text-primary"></i>Opportunities (@c.Opportunities.Count)</span>
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-sm btn-outline-primary py-0">
            <i class="bi bi-plus-lg"></i> Add Deal
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Opportunity Name</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Probability</th>
                    <th>Weighted Value</th>
                    <th>Close Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (c.Opportunities.Any())
                {
                    @foreach (var o in c.Opportunities)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border font-monospace">@o.OpportunityCode</span></td>
                            <td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold text-decoration-none text-dark">@o.OpportunityName</a></td>
                            <td class="fw-bold text-primary">$@o.Amount.ToString("N0")</td>
                            <td><span class="badge bg-info-subtle text-info">@o.Stage</span></td>
                            <td>@o.Probability%</td>
                            <td>$@o.WeightedValue.ToString("N0")</td>
                            <td>@o.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (o.Status == OpportunityStatus.Won)
                                {
                                    <span class="badge bg-success-subtle text-success">Won</span>
                                }
                                else if (o.Status == OpportunityStatus.Lost)
                                {
                                    <span class="badge bg-danger-subtle text-danger">Lost</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary">Open</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No opportunities registered for this customer yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Related Follow-Ups and Activities -->
<div class="row g-3">
    <!-- Follow-Ups -->
    <div class="col-lg-6">
        <div class="card mb-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar-event me-2 text-info"></i>Follow-Ups (@c.FollowUps.Count)</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-sm btn-outline-info py-0 text-dark">
                    <i class="bi bi-plus-lg"></i> Schedule
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (c.FollowUps.Any())
                        {
                            @foreach (var f in c.FollowUps)
                            {
                                <tr>
                                    <td><small>@f.FollowUpDate.ToString("MMM dd, yyyy")</small></td>
                                    <td><div class="fw-semibold">@f.Subject</div></td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td>
                                        @if (f.Status == FollowUpStatus.Completed)
                                        {
                                            <span class="badge bg-success-subtle text-success">Done</span>
                                        }
                                        else if (f.Status == FollowUpStatus.Planned)
                                        {
                                            <span class="badge bg-primary-subtle text-primary">Planned</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">@f.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-3 text-muted">No follow-ups recorded.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Activities -->
    <div class="col-lg-6">
        <div class="card mb-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history me-2 text-secondary"></i>Activity Log (@c.Activities.Count)</span>
                <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-sm btn-outline-secondary py-0">
                    <i class="bi bi-plus-lg"></i> Log
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Headline</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (c.Activities.Any())
                        {
                            @foreach (var a in c.Activities)
                            {
                                <tr>
                                    <td><small>@a.ActivityDate.ToString("MMM dd, yyyy")</small></td>
                                    <td><span class="badge bg-light text-dark border">@a.ActivityType</span></td>
                                    <td>
                                        <div class="fw-semibold">@a.Subject</div>
                                        @if (!string.IsNullOrEmpty(a.Description))
                                        {
                                            <small class="text-muted d-block">@a.Description</small>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center py-3 text-muted">No activities logged.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
