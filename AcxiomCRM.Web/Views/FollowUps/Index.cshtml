@model FollowUpListViewModel
@using AcxiomCRM.Core.Enums
@{
    ViewData["Title"] = "Follow-Ups & Action Items";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 text-gray-800">Follow-Up Schedule</h1>
        <p class="text-muted mb-0">Plan, complete, and reschedule calls, meetings, emails, and client tasks.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Alert highlights: Overdue & Today -->
@if (Model.OverdueFollowUps.Any())
{
    <div class="alert alert-danger shadow-sm border-danger d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
        <div class="flex-grow-1">
            <h6 class="alert-heading mb-1 fw-bold">Action Required: @Model.OverdueFollowUps.Count Overdue Follow-Up(s)</h6>
            <div class="small">
                @foreach (var ov in Model.OverdueFollowUps.Take(3))
                {
                    <span class="badge bg-danger me-2">@ov.Subject (@ov.FollowUpDate.ToString("MMM dd"))</span>
                }
            </div>
        </div>
    </div>
}

<!-- Filters Card -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-2">
                <label class="form-label text-muted small">Status</label>
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<FollowUpStatus>()">
                    <option value="">-- All Statuses --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">Type</label>
                <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<FollowUpType>()">
                    <option value="">-- All Types --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">From Date</label>
                <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">To Date</label>
                <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small">Assigned Executive</label>
                <select name="assignedToId" class="form-select" asp-items="Model.SalesUsersList">
                    <option value="">-- All Executives --</option>
                </select>
            </div>
            <div class="col-md-1 d-flex align-items-end gap-1">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 fw-bold text-primary">Follow-Up Records (@Model.TotalCount)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Type</th>
                        <th>Subject & Remarks</th>
                        <th>Related Record</th>
                        <th>Assigned User</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FollowUps.Any())
                    {
                        foreach (var f in Model.FollowUps)
                        {
                            var isOverdue = f.Status == FollowUpStatus.Planned && f.FollowUpDate.Date < DateTime.UtcNow.Date;
                            var typeIcon = f.FollowUpType switch
                            {
                                FollowUpType.Call => "bi-telephone-outbound text-primary",
                                FollowUpType.Meeting => "bi-people text-success",
                                FollowUpType.Email => "bi-envelope text-info",
                                _ => "bi-list-check text-secondary"
                            };

                            var statusBadge = f.Status switch
                            {
                                FollowUpStatus.Completed => "bg-success",
                                FollowUpStatus.Missed => "bg-danger",
                                FollowUpStatus.Cancelled => "bg-secondary",
                                _ => isOverdue ? "bg-danger" : "bg-warning text-dark"
                            };

                            <tr class="@(isOverdue ? "table-danger-light" : "")">
                                <td>
                                    <div class="fw-bold @(isOverdue ? "text-danger" : "")">
                                        @f.FollowUpDate.ToString("MMM dd, yyyy")
                                    </div>
                                    @if (isOverdue)
                                    {
                                        <small class="badge bg-danger">Overdue</small>
                                    }
                                    else if (f.FollowUpDate.Date == DateTime.UtcNow.Date)
                                    {
                                        <small class="badge bg-primary">Today</small>
                                    }
                                </td>
                                <td>
                                    <span class="d-inline-flex align-items-center gap-1">
                                        <i class="bi @typeIcon"></i> @f.FollowUpType
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@f.Subject</div>
                                    @if (!string.IsNullOrWhiteSpace(f.Remarks))
                                    {
                                        <small class="text-muted d-block text-truncate" style="max-width: 280px;">@f.Remarks</small>
                                    }
                                </td>
                                <td>
                                    @if (f.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="text-decoration-none">
                                            <i class="bi bi-building me-1"></i>@f.Customer.CustomerName
                                        </a>
                                    }
                                    else if (f.Lead != null)
                                    {
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="text-decoration-none">
                                            <i class="bi bi-person me-1"></i>@f.Lead.LeadName
                                        </a>
                                    }
                                    else if (f.Opportunity != null)
                                    {
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@f.OpportunityId" class="text-decoration-none">
                                            <i class="bi bi-briefcase me-1"></i>@f.Opportunity.OpportunityName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">General</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@(f.AssignedTo?.FullName ?? "Unassigned")</small>
                                </td>
                                <td>
                                    <span class="badge @statusBadge px-2 py-1">@f.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (f.Status == FollowUpStatus.Planned)
                                        {
                                            <!-- Quick Complete -->
                                            <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Mark as Completed">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <!-- Reschedule -->
                                            <a asp-action="Reschedule" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-warning" title="Reschedule Date">
                                                <i class="bi bi-calendar2-range"></i>
                                            </a>
                                        }
                                        <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-light border" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-check text-secondary display-6 d-block mb-2"></i>
                                No follow-up activities found matching criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <small class="text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-status="@Model.Status" asp-route-type="@Model.Type"
                           asp-route-assignedToId="@Model.AssignedToId">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p"
                               asp-route-status="@Model.Status" asp-route-type="@Model.Type"
                               asp-route-assignedToId="@Model.AssignedToId">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-status="@Model.Status" asp-route-type="@Model.Type"
                           asp-route-assignedToId="@Model.AssignedToId">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
