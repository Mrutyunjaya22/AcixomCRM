@model FollowUpRescheduleViewModel
@{
    ViewData["Title"] = "Reschedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1 text-gray-800">Reschedule Follow-Up</h1>
                <p class="text-muted mb-0">Select a new date and enter the reason for rescheduling.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-primary"><i class="bi bi-calendar2-range me-2"></i>@Model.Subject</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="Reschedule" asp-route-id="@Model.FollowUpId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FollowUpId" />
                    <input type="hidden" asp-for="Subject" />
                    <input type="hidden" asp-for="CurrentDate" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="p-3 bg-light rounded mb-3">
                        <small class="text-muted d-block">Currently Scheduled For:</small>
                        <span class="fw-bold fs-5 text-dark">@Model.CurrentDate.ToString("dddd, MMMM dd, yyyy")</span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewDate" class="form-label fw-semibold"></label>
                        <input asp-for="NewDate" class="form-control" type="date" />
                        <small class="form-text text-muted">New date must be today or in the future.</small>
                        <span asp-validation-for="NewDate" class="text-danger small d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Remarks" class="form-label fw-semibold"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Client requested later date, waiting on internal proposal approval, etc..."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4 text-dark fw-semibold">
                            <i class="bi bi-calendar-check me-1"></i> Confirm Reschedule
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
