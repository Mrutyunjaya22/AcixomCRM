@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 500px;">
        <div class="card-body p-5">
            <div class="text-danger mb-3" style="font-size: 3.5rem;">
                <i class="bi bi-shield-x"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
            <p class="text-muted mb-4">
                You do not have permission to access this resource or execute this administrative action.
                Role-based and resource ownership security policies are enforced on this route.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Go Back
                </a>
            </div>
        </div>
    </div>
</div>
