@model UserListViewModel
@using AcxiomCRM.Core.Constants
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 text-gray-800">User & Role Management</h1>
        <p class="text-muted mb-0">Manage CRM user accounts, assign roles, and control access permissions.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Add New User
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-5">
                <label class="form-label text-muted small">Search Users</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by Name or Email..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small">Role Filter</label>
                <select name="role" class="form-select" asp-items="Model.RolesList">
                    <option value="">-- All Roles --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small">Status</label>
                <select name="isActive" class="form-select">
                    <option value="">-- All --</option>
                    <option value="true" selected="@(Model.IsActive == true)">Active</option>
                    <option value="false" selected="@(Model.IsActive == false)">Deactivated</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 fw-bold text-primary">System Users (@Model.Users.Count)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Security / Lockout</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Any())
                    {
                        foreach (var u in Model.Users)
                        {
                            var roleBadge = u.Role switch
                            {
                                Roles.Admin => "bg-danger",
                                Roles.Manager => "bg-info text-dark",
                                _ => "bg-primary"
                            };

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                            @u.FullName.FirstOrDefault()
                                        </div>
                                        <div>
                                            <div class="fw-bold">@u.FullName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@u.Email</span>
                                </td>
                                <td>
                                    <span class="badge @roleBadge px-2 py-1">@u.Role</span>
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-light text-success border border-success px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-light text-danger border border-danger px-2 py-1">Deactivated</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsLockedOut)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                                            <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2 small" title="Clear Account Lockout">Unlock</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted"><i class="bi bi-shield-check text-success me-1"></i>Normal</small>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@u.CreatedDate.ToString("MMM dd, yyyy")</small>
                                </td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-action="EditRole" asp-route-id="@u.Id">
                                                    <i class="bi bi-shield-lock me-2"></i>Change Role
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="ResetPassword" asp-route-id="@u.Id">
                                                    <i class="bi bi-key me-2"></i>Reset Password
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item @(u.IsActive ? "text-danger" : "text-success")">
                                                        <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check") me-2"></i>
                                                        @(u.IsActive ? "Deactivate Account" : "Activate Account")
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-people text-secondary display-6 d-block mb-2"></i>
                                No users found matching criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
