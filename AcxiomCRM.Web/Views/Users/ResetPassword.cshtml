@model UserResetPasswordViewModel
@{
    ViewData["Title"] = $"Reset Password - {Model.Email}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1 text-gray-800">Admin Password Reset</h1>
                <p class="text-muted mb-0">Directly set a new secure password for this user account.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Users
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-primary"><i class="bi bi-key me-2"></i>Reset Credentials for @Model.Email</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="ResetPassword" asp-route-id="@Model.UserId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="p-3 bg-light rounded mb-3">
                        <small class="text-muted d-block">Account:</small>
                        <span class="fw-bold text-dark">@Model.Email</span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control" />
                        <small class="form-text text-muted">Minimum 8 characters with upper, lower, digit, and special characters.</small>
                        <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-shield-check me-1"></i> Set New Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
