@model LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-0 text-dark">Convert Lead to Customer</h4>
                <small class="text-muted">Transactional sales lifecycle conversion</small>
            </div>
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
        </div>

        <div class="card p-4">
            <div class="alert alert-info d-flex align-items-center mb-4">
                <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                <div class="small">
                    Converting this lead will:
                    <ul class="mb-0 ps-3">
                        <li>Create a verified Customer master record.</li>
                        @if (Model.ExpectedValue > 0)
                        {
                            <li>Create a Qualification-stage Opportunity with amount <strong>$@Model.ExpectedValue.ToString("N0")</strong>.</li>
                        }
                        <li>Permanently link the lead history to the new customer record.</li>
                    </ul>
                </div>
            </div>

            <div class="bg-light p-3 rounded mb-4">
                <div class="row g-2 small">
                    <div class="col-sm-6"><span class="text-muted">Lead Name:</span> <strong class="d-block">@Model.LeadName</strong></div>
                    <div class="col-sm-6"><span class="text-muted">Company:</span> <strong class="d-block">@(Model.CompanyName ?? "N/A")</strong></div>
                    <div class="col-sm-6"><span class="text-muted">Email:</span> <strong class="d-block">@Model.Email</strong></div>
                    <div class="col-sm-6"><span class="text-muted">Expected Value:</span> <strong class="d-block text-primary">$@Model.ExpectedValue.ToString("N0")</strong></div>
                </div>
            </div>

            <form asp-action="Convert" asp-route-id="@Model.LeadId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LeadId" />
                <input type="hidden" asp-for="LeadName" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="CompanyName" />
                <input type="hidden" asp-for="ExpectedValue" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Additional notes or onboarding remarks for the new customer..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i> Confirm & Convert Lead
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
