@model LeadCreateEditViewModel
@{
    ViewData["Title"] = "Add Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-0 text-dark">Capture New Lead</h4>
                <small class="text-muted">Register a prospect for sales qualification</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="LeadName" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="LeadName" class="form-control" placeholder="Jane Doe" />
                        <span asp-validation-for="LeadName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label"></label>
                        <input asp-for="CompanyName" class="form-control" placeholder="Company Inc." />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Email" class="form-control" placeholder="jane.doe@company.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Phone" class="form-control" placeholder="9876543210" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Source" class="form-label"></label>
                        <select asp-for="Source" class="form-select">
                            <option value="@LeadSource.Website">Website</option>
                            <option value="@LeadSource.Referral">Referral</option>
                            <option value="@LeadSource.ColdCall">Cold Call</option>
                            <option value="@LeadSource.SocialMedia">Social Media</option>
                            <option value="@LeadSource.EmailCampaign">Email Campaign</option>
                            <option value="@LeadSource.Event">Event</option>
                            <option value="@LeadSource.Other">Other</option>
                        </select>
                        <span asp-validation-for="Source" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="@LeadStatus.New">New</option>
                            <option value="@LeadStatus.Contacted">Contacted</option>
                            <option value="@LeadStatus.Qualified">Qualified</option>
                            <option value="@LeadStatus.Unqualified">Unqualified</option>
                            <option value="@LeadStatus.Lost">Lost</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Priority" class="form-label"></label>
                        <select asp-for="Priority" class="form-select">
                            <option value="@LeadPriority.Low">Low</option>
                            <option value="@LeadPriority.Medium">Medium</option>
                            <option value="@LeadPriority.High">High</option>
                        </select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpectedValue" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="ExpectedValue" class="form-control" type="number" step="100" min="0" />
                        </div>
                        <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                    </div>

                    @if (Model.SalesUsersList != null && Model.SalesUsersList.Any())
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedToId" class="form-label"></label>
                            <select asp-for="AssignedToId" asp-items="Model.SalesUsersList" class="form-select">
                                <option value="">-- Assign Sales Executive --</option>
                            </select>
                            <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Background details, timeline, or pain points..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Save Lead
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
